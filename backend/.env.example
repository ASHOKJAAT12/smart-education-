# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartlearn?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_strong_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_strong_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Brevo (Email) ────────────────────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_email
BREVO_SMTP_PASS=your_brevo_smtp_key
BREVO_FROM_EMAIL=noreply@smartlearnai.com
BREVO_FROM_NAME=SmartLearn AI

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
AI_DAILY_QUOTA=20
