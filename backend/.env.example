# ═══════════════════════════════════════════════════════════════════════════
# SmartLearn AI — Backend environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# NEVER commit `.env`. It is git-ignored.
#
# Legend:  [REQUIRED] server refuses to start without it
#          [OPTIONAL] feature degrades gracefully when absent
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
# development | production | test
NODE_ENV=development
# error | warn | info | debug   (defaults: info in production, debug otherwise)
LOG_LEVEL=debug

# ─── Database [REQUIRED] ───────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/smartlearn
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartlearn?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartlearn

# ─── Authentication [REQUIRED] ─────────────────────────────────────────────
# Must be at least 32 random characters and DIFFERENT from each other.
# The server refuses to start in production with short or placeholder secrets.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access tokens should be short-lived; refresh tokens carry the session.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing cost. 12 is a good balance; higher is slower to log in.
BCRYPT_ROUNDS=12

# ─── CORS [REQUIRED] ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slash.
# Production allows ONLY these origins — wildcards are never used.
# e.g. CLIENT_URL=https://smartlearn.example.com,https://www.smartlearn.example.com
CLIENT_URL=http://localhost:5173

# ─── AI provider [OPTIONAL] ────────────────────────────────────────────────
# Without a key: AI endpoints return 503 in production and clearly-labelled
# demo text in development. Learning, quizzes, progress and recommendations
# all continue to work normally.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# 0.0 = deterministic, 1.0 = creative
AI_TEMPERATURE=0.7

# ─── Cloudinary (file uploads) [OPTIONAL] ──────────────────────────────────
# All three are required together; uploads are disabled if any is missing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Brevo SMTP (transactional email) [OPTIONAL] ───────────────────────────
# Without these, emails are logged to the console in development.
# Password-reset links are then only visible in server logs.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=noreply@smartlearn.example.com
BREVO_FROM_NAME=SmartLearn AI
